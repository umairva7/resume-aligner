# App Configuration
APP_NAME="Resume Aligner"
APP_ENV="development"
DEBUG=True
PORT=8000

# Database Configuration
DATABASE_URL="sqlite:///./resume_aligner.db"

# Storage Directories
BASE_RESUME_DIR="./uploads/base_resumes"
TAILORED_RESUME_DIR="./uploads/tailored_resumes"

# LLM Provider Options: "mock", "ollama", "groq", "huggingface", "gemini"
LLM_PROVIDER="mock"

# Hugging Face Inference API (if LLM_PROVIDER="huggingface")
HF_API_KEY="hf_your_token_here"
HF_MODEL="meta-llama/Meta-Llama-3-8B-Instruct"

# Groq API (if LLM_PROVIDER="groq")
GROQ_API_KEY="gsk_your_key_here"

# Ollama Local (if LLM_PROVIDER="ollama")
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Gemini API (if LLM_PROVIDER="gemini")
GEMINI_API_KEY="your_gemini_key"
