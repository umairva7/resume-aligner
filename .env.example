# App Configuration
APP_NAME="Resume Aligner"
APP_ENV="production" # "development" or "production"
DEBUG=False
PORT=8000

# Database Configuration
DATABASE_URL="sqlite:///./resume_aligner.db"

# Storage Directories
BASE_RESUME_DIR="./uploads/base_resumes"
TAILORED_RESUME_DIR="./uploads/tailored_resumes"

# Security & CORS
SESSION_SECRET="generate-a-strong-random-32-character-secret"
SECURE_COOKIES=True
FRONTEND_URL="https://yourdomain.com"
ALLOWED_ORIGINS="https://yourdomain.com,http://localhost:8000"

# OAuth Google Authentication (Optional - Demo fallback available)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="https://yourdomain.com/api/v1/auth/callback"

# LLM Provider Options: "groq", "ollama", "huggingface", "gemini", "mock"
LLM_PROVIDER="groq"
LLM_TIMEOUT_SECONDS=30.0

# Groq API (Recommended for cloud hosting with sub-second latency)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.1-8b-instant"

# Hugging Face Inference API (Alternative cloud provider)
HF_API_KEY="hf_your_huggingface_token_here"
HF_MODEL="meta-llama/Meta-Llama-3-8B-Instruct"

# Ollama Local (For VPS/On-Premise with local GPU)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Gemini API
GEMINI_API_KEY="your_gemini_api_key"
